# 이 파일을 .env로 복사해서 값을 채우세요. .env는 깃허브에 올라가지 않습니다.

# 인스타그램 자동 게시 (README "인스타그램 자동 게시" 참고)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Instagram 로그인 방식: graph.instagram.com / Facebook 페이지 연결 방식: graph.facebook.com
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v23.0

# AI 연결 (scripts/ai.mjs)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
